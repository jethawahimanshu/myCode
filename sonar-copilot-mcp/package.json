  "description": "MCP server for GitHub Copilot to automatically resolve SonarLint issues in IntelliJ IDEA",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
